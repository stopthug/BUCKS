# ---------------------------------------------------------------------------
# $BUCKS — environment
#
# Copy to .env.local for development, or paste into Vercel's project settings
# for production. Every value here is server-side only: nothing in this file is
# exposed to the browser, and lib/env.ts refuses to boot with a bad value.
# ---------------------------------------------------------------------------

# Postgres. Supabase works out of the box — use the connection pooler URL.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 32+ random characters. Signs the session cookie.
#   openssl rand -base64 48
SESSION_SECRET=

# Public origin, no trailing slash. Used for login messages and gift links.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------

# A mainnet RPC. The public endpoint is rate-limited too hard for checkout;
# use Helius, Triton, QuickNode or similar in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter Swap API v2 key from https://portal.jup.ag. Quotes work without one,
# but production traffic needs it.
JUPITER_API_KEY=
JUPITER_API_BASE_URL=https://api.jup.ag/swap/v2

# Verified mint addresses. A symbol is never trusted on its own, and decimals
# are read from the chain at runtime.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Required to offer “Pay with xStocks” (SBUXx) at checkout. Leave blank to hide
# a working quote — the UI still shows the option and the quote API returns
# asset_not_configured until this is set.
SBUXX_MINT=
BUCKS_MINT=6UcPKa4Y8QuZrhLb8eKD6jcXHaZFC7nUUcEfGFs1KYwP

# Wallet that receives checkout payments (SOL, USDC, SBUXx). Buyers send from
# their own wallet via Solana Pay; this address is shown in the QR.
TREASURY_WALLET=

# ---------------------------------------------------------------------------
# FazerCards (gift-card fulfilment)
# ---------------------------------------------------------------------------

# Required in production. From the reseller dashboard: Settings -> API.
# Never expose this to a browser, commit it, or paste it into source.
FAZER_API_KEY=
FAZER_API_BASE_URL=https://api.fzr.cards/api/v2

# From the reseller dashboard: Settings -> Webhook. Required to accept webhooks;
# without it the webhook endpoint rejects everything and orders fall back to
# polling.
FAZER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# $BUCKS / SBUXx market data
# ---------------------------------------------------------------------------

# Leave blank until the pair exists. Blank means the site says
# "$BUCKS / SBUXx pair coming soon." rather than inventing a price.
BUCKS_SBUXX_PAIR_ADDRESS=
BUCKS_TRADE_URL=
DEXSCREENER_URL=https://dexscreener.com/solana/4GPKNeeqNSqQPKZf2sPcc8ixfwWM7kNqe4heMiWiCoDe

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------

# 32 bytes, hex or base64. Encrypts gift-card redemption data and claim tokens
# at rest. Rotating this makes existing stored codes unreadable.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------

# Local-only. Set to 1 to answer FazerCards calls from an isolated fixture so
# checkout can be exercised without a funded reseller account. Leave 0 (or
# unset) to use the live catalog. Ignored in production.
FAZER_DEV_MOCK=0
